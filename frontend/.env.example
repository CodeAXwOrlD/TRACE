# Base URL of the future FastAPI backend (Architecture.md section 9).
# Until Member 3's API exists, lib/api.ts falls back to mock data whenever
# this is unset or the request fails, so the frontend runs standalone.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to force mock data even if NEXT_PUBLIC_API_URL is reachable
# (useful for demo days / offline work).
NEXT_PUBLIC_USE_MOCKS=true
